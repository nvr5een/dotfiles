# ~/.zprofile

# Homebrew's environment belongs in the login-shell configuration so it is not
# recalculated for every interactive shell and tmux pane.
typeset -U path PATH

for _brew in \
  /opt/homebrew/bin/brew \
  /usr/local/bin/brew \
  /home/linuxbrew/.linuxbrew/bin/brew \
  "$HOME/.linuxbrew/bin/brew"
do
  if [[ -x $_brew ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
