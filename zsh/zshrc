# ~/.zshrc

# Load the profiler only when explicitly requested. The report is printed after
# the rest of the configuration has loaded.
if [[ -n $ZSH_PROFILE ]]; then
  zmodload zsh/zprof
fi

# Respect an existing XDG setup.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export ZSH_CONFIG="${ZSH_CONFIG:-$XDG_CONFIG_HOME/zsh}"
export ZSH_CACHE="${ZSH_CACHE:-$XDG_CACHE_HOME/zsh}"

mkdir -p -- "$ZSH_CACHE"

# Programs.
export VISUAL="${VISUAL:-vim}"
export EDITOR="${EDITOR:-$VISUAL}"
export PAGER="${PAGER:-less}"
export LESS="${LESS:--FRX}"

# Do not force LC_ALL: it overrides every locale category and is fragile on
# minimal Linux hosts. Preserve inherited settings and provide a sane LANG.
if [[ -z $LANG ]]; then
  if [[ $OSTYPE == darwin* ]]; then
    export LANG=en_US.UTF-8
  else
    export LANG=C.UTF-8
  fi
fi

# Zsh keeps the scalar PATH and array path synchronized. Duplicate entries are
# removed while preserving the leftmost entry.
typeset -U path PATH

# Make non-login Alacritty shells usable without running `brew shellenv` on every
# startup. Full Homebrew initialization belongs in ~/.zprofile.
typeset -g ZSH_HOMEBREW_PREFIX=${HOMEBREW_PREFIX:-}
if [[ -z $ZSH_HOMEBREW_PREFIX ]]; then
  for _zsh_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
    if [[ -x $_zsh_prefix/bin/brew ]]; then
      ZSH_HOMEBREW_PREFIX=$_zsh_prefix
      break
    fi
  done
  unset _zsh_prefix
fi

if [[ -n $ZSH_HOMEBREW_PREFIX ]]; then
  typeset -a _zsh_brew_paths
  for _zsh_path in \
    "$ZSH_HOMEBREW_PREFIX/opt/curl/bin" \
    "$ZSH_HOMEBREW_PREFIX/opt/libpq/bin" \
    "$ZSH_HOMEBREW_PREFIX/bin" \
    "$ZSH_HOMEBREW_PREFIX/sbin"
  do
    [[ -d $_zsh_path ]] && _zsh_brew_paths+=("$_zsh_path")
  done
  path=($_zsh_brew_paths $path)
  unset _zsh_brew_paths _zsh_path
fi

# User commands take precedence over package-manager commands.
[[ -d $HOME/.local/bin ]] && path=("$HOME/.local/bin" $path)
[[ -d $HOME/projects/private/bin ]] && path=("$HOME/projects/private/bin" $path)

# GNU tools use LS_COLORS; BSD ls uses LSCOLORS. Some versions of GNU
# dircolors do not recognize TERM=alacritty and return an empty palette. In
# that case, generate the palette as xterm-256color without changing TERM in
# the interactive shell.
typeset _dircolors_command _dircolors_output
if (( $+commands[dircolors] )); then
  _dircolors_command=$commands[dircolors]
elif (( $+commands[gdircolors] )); then
  _dircolors_command=$commands[gdircolors]
fi

if [[ -n $_dircolors_command ]]; then
  if [[ -r $XDG_CONFIG_HOME/dircolors ]]; then
    _dircolors_output=$("$_dircolors_command" -b "$XDG_CONFIG_HOME/dircolors")
  else
    _dircolors_output=$("$_dircolors_command" -b)
  fi
  eval "$_dircolors_output"

  if [[ -z $LS_COLORS && $TERM == alacritty* ]]; then
    if [[ -r $XDG_CONFIG_HOME/dircolors ]]; then
      _dircolors_output=$(TERM=xterm-256color "$_dircolors_command" -b "$XDG_CONFIG_HOME/dircolors")
    else
      _dircolors_output=$(TERM=xterm-256color "$_dircolors_command" -b)
    fi
    eval "$_dircolors_output"
  fi
else
  export LSCOLORS="${LSCOLORS:-ExGxFxDxCxDxDxBxBxBx}"
fi
unset _dircolors_command _dircolors_output

[[ -r $XDG_CONFIG_HOME/grepcolors.sh ]] && source "$XDG_CONFIG_HOME/grepcolors.sh"

# Load each concern explicitly so ordering stays predictable.
for _zsh_file in \
  options.zsh \
  history.zsh \
  completion.zsh \
  plugins.zsh \
  keybindings.zsh \
  aliases.zsh \
  prompt.zsh
do
  [[ -r $ZSH_CONFIG/$_zsh_file ]] && source "$ZSH_CONFIG/$_zsh_file"
done
unset _zsh_file

# Machine-specific settings and secrets belong here.
[[ -r $ZSH_CONFIG/local.zsh ]] && source "$ZSH_CONFIG/local.zsh"

if [[ -n $ZSH_PROFILE ]]; then
  zprof
fi
