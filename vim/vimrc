" ~/.vimrc
"
"  ██▒   █▓ ██▓ ███▄ ▄███▓ ██▀███   ▄████▄
" ▓██░   █▒▓██▒▓██▒▀█▀ ██▒▓██ ▒ ██▒▒██▀ ▀█
"  ▓██  █▒░▒██▒▓██    ▓██░▓██ ░▄█ ▒▒▓█    ▄
"   ▒██ █░░░██░▒██    ▒██ ▒██▀▀█▄  ▒▓▓▄ ▄██▒
"    ▒▀█░  ░██░▒██▒   ░██▒░██▓ ▒██▒▒ ▓███▀ ░
"    ░ ▐░  ░▓  ░ ▒░   ░  ░░ ▒▓ ░▒▓░░ ░▒ ▒  ░
"    ░ ░░   ▒ ░░  ░      ░  ░▒ ░ ▒░  ░  ▒
"      ░░   ▒ ░░      ░     ░░   ░ ░
"       ░   ░         ░      ░     ░ ░
"      ░                           ░

" ── Filetype & Syntax ────────────────────────────────────────
filetype plugin indent on           " enable filetype detection, plugins, and indentation
syntax enable                       " enable syntax highlighting

" ── Indentation & Tabs ───────────────────────────────────────
set autoindent                      " copy current line's indent onto new lines
set expandtab                       " insert spaces instead of literal tab characters
set tabstop=2                       " display tab characters as 2 columns
set shiftwidth=2                    " use 2 spaces for indentation commands
set softtabstop=2                   " insert/delete 2 spaces when pressing Tab/Backspace

" ── Formatting ───────────────────────────────────────────────
set formatoptions=croqlj            " format comments, preserve joins, and support gq

" ── Search ───────────────────────────────────────────────────
set hlsearch                        " highlight all search matches
set ignorecase                      " ignore case in searches by default
set smartcase                       " make searches case-sensitive when pattern has uppercase
set incsearch                       " show matches while typing a search

" ── Undo / Backup ────────────────────────────────────────────
set undodir=~/.vim/undo             " store persistent undo files here
set undofile                        " preserve undo history across Vim sessions
set noswapfile                      " disable swap files

" Create the persistent undo directory if it does not exist
if !isdirectory(expand(&undodir))
  call mkdir(expand(&undodir), 'p', 0700)
endif

" ── General Editing Behavior ─────────────────────────────────
set autoread                        " reload files changed outside Vim when safe
set hidden                          " allow modified buffers to remain hidden
set backspace=indent,eol,start      " allow Backspace across indents, line breaks, and insert start
set modelines=0                     " disable modelines for security
set ttimeout                        " use a separate timeout for terminal key codes
set ttimeoutlen=50                  " wait 50 ms for terminal key-code sequences
set updatetime=100                  " shorten idle update interval for plugins such as gitgutter

" Search the current directory and subdirectories with :find
set path=.,**

" Use ripgrep for recursive project searches when available
if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case\ --hidden\ --glob\ !.git/*
  set grepformat=%f:%l:%c:%m
endif

" ── Movement & View ──────────────────────────────────────────
set number                          " show absolute line numbers
set relativenumber                  " show relative line numbers for nearby lines
set cursorline                      " highlight the current screen line
set scrolloff=5                     " keep 5 screen lines visible above and below cursor
set display=lastline,truncate       " show partial last lines and mark truncated text
set signcolumn=yes                  " keep the sign column visible to avoid text shifting
set virtualedit=block,onemore       " allow virtual columns in block mode and one past EOL
set splitbelow                      " open horizontal splits below the current window
set splitright                      " open vertical splits to the right

" ── Wildmenu / Completion ────────────────────────────────────
set wildmenu                        " enable enhanced command-line completion
set wildcharm=<C-z>                 " trigger wildcard completion from mappings
set wildoptions=pum                 " display completion matches in a popup menu
set wildmode=longest:full,full      " complete longest match, then cycle through matches
set wildignorecase                  " ignore case during command-line completion
set wildignore+=*.git,*.gz,*.rar,*.zip
set wildignore+=node_modules/**,dist/**,build/**,.git/**,__pycache__/**,.venv/**

" ── Statusline ───────────────────────────────────────────────
set laststatus=2                    " always display the statusline
set noshowmode                      " hide Vim's mode message; mode is shown below
set statusline=                     " clear the default statusline
set statusline+=[%{mode()}]         " current mode
set statusline+=\ %F                " full file path
set statusline+=%m                  " modified flag
set statusline+=%r                  " read-only flag
set statusline+=%=                  " right-align the remaining fields
set statusline+=\ %y                " filetype
set statusline+=\ %{&fileencoding?&fileencoding:&encoding} " file encoding
set statusline+=\ \|\ %{&fileformat} " line-ending format
set statusline+=\ [%p%%             " percentage through file
set statusline+=\ %l:%c]            " line and column
set statusline+=%{ShowGitBranch()}  " cached Git branch

" ── Syntax & Colors ──────────────────────────────────────────
colorscheme sourcerer               " use the Sourcerer colorscheme

" ── Cursor Shape ─────────────────────────────────────────────
let &t_SI = "\e[6 q"                " use a steady beam cursor in Insert mode
let &t_EI = "\e[2 q"                " use a steady block cursor in Normal mode

" ── Mappings ─────────────────────────────────────────────────
let mapleader="\<Space>"            " use Space as the leader key

" Exit Insert mode with jk
inoremap jk <Esc>

" Yank from cursor to end of line with Y
nnoremap Y y$

" Toggle to the alternate buffer
nnoremap <leader><Space> :e#<CR>

" Open buffer completion
nnoremap <leader>b :buffer <C-z><S-Tab>

" Find a file using 'path' and wildmenu completion
nnoremap <leader>f :find *

" Edit this vimrc
nnoremap <leader>v :edit $MYVIMRC<CR>

" Open private notes when the directory exists
if !empty(glob('~/projects/private/notes'))
  nnoremap <leader>n :e ~/projects/private/notes/
endif

" Replace the word under cursor throughout the current file
nnoremap <leader>r :%s/\<<C-r><C-w>\>//g<Left><Left>

" Clear search highlighting and refresh diff state
if maparg('<C-L>', 'n') ==# ''
  nnoremap <silent> <C-L> :nohlsearch<C-R>=has('diff')?'<Bar>diffupdate':''<CR><CR><C-L>
endif

" Move by screen lines when no count is supplied
nnoremap <silent> <expr> j (v:count == 0 ? 'gj' : 'j')
nnoremap <silent> <expr> k (v:count == 0 ? 'gk' : 'k')

" Cycle through windows
nnoremap <tab> <C-w>w
nnoremap <S-tab> <C-w>W

" Toggle absolute and relative line numbers together
nnoremap <leader>i :set invnumber invrelativenumber<CR>

" Join lines without moving the cursor
nnoremap J mzJ`z

" Keep the cursor centered while paging
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Keep search matches centered and reveal folded matches
nnoremap n nzzzv
nnoremap N Nzzzv

" Yank explicitly to the system clipboard without changing Vim's default clipboard
nnoremap <Leader>y "+y
vnoremap <leader>y "+y

" Use Q as the gq formatting operator instead of Ex mode
nnoremap Q gq

" Remove trailing whitespace from the current buffer
nnoremap <leader>s :call StripWhitespace()<CR>

" Open quickfix only when it contains entries; close it explicitly
nnoremap <leader>q :cwindow<CR>
nnoremap <leader>Q :cclose<CR>

" ── Functions ────────────────────────────────────────────────
" Cache the Git branch for the current working directory
function! UpdateGitBranch() abort
  if executable('git')
    let l:branch = system('git rev-parse --abbrev-ref HEAD 2>/dev/null')

    if v:shell_error == 0
      let g:git_branch = trim(l:branch)
    else
      let g:git_branch = ''
    endif
  else
    let g:git_branch = ''
  endif
endfunction

" Return the cached Git branch for the statusline
function! ShowGitBranch() abort
  return empty(get(g:, 'git_branch', ''))
        \ ? ''
        \ : ' | Git: ' . g:git_branch
endfunction

" Remove trailing whitespace while preserving the window view and search register
function! StripWhitespace() abort
  let l:view = winsaveview()
  let l:old_query = getreg('/')

  %s/\s\+$//e

  call winrestview(l:view)
  call setreg('/', l:old_query)
endfunction

" ── Autocommands ─────────────────────────────────────────────
augroup vimStartup
  autocmd!

  " Apply filetype-specific editing and display settings
  autocmd FileType python setlocal foldmethod=indent tabstop=4 shiftwidth=4 softtabstop=4 expandtab
  autocmd FileType markdown,text setlocal textwidth=78 colorcolumn=+1
  autocmd FileType markdown syntax sync fromstart

  " Override filetype detection for known configuration files
  autocmd BufNewFile,BufReadPost *.config setfiletype sshconfig
  autocmd BufNewFile,BufReadPost vifmrc*,*.vifm setfiletype vifm

  " Check for external file changes when returning to Vim or entering a buffer
  autocmd FocusGained,BufEnter * checktime

  " Rebalance split sizes after the terminal is resized
  autocmd VimResized * wincmd =

  " Refresh the cached Git branch when entering Vim or another buffer
  autocmd VimEnter,BufEnter * call UpdateGitBranch()

  " Refresh the cached Git branch when the working directory changes
  if exists('##DirChanged')
    autocmd DirChanged * call UpdateGitBranch()
  endif

  " Restore the last cursor position when reopening files, except commit messages
  autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit'
        \ |   execute "normal! g`\""
        \ | endif
augroup END

" ── Plugins (vim-plug) ───────────────────────────────────────
" Download vim-plug automatically if it is not installed
if empty(glob('~/.vim/autoload/plug.vim'))
  silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs
    \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
endif

" Declare plugins
call plug#begin()
Plug 'airblade/vim-gitgutter'      " show Git changes in the sign column
Plug 'justinmk/vim-dirvish'        " lightweight directory browser
Plug 'tpope/vim-commentary'        " comment and uncomment text with motions
Plug 'tpope/vim-surround'          " add, change, and remove surrounding pairs
Plug 'tpope/vim-repeat'            " make supported plugin actions repeatable with .
Plug 'tpope/vim-unimpaired'        " provide complementary bracket mappings
Plug 'hashivim/vim-terraform'      " add Terraform syntax and editing support
call plug#end()

" Install any declared plugins that are missing when Vim starts
augroup vimPlugBootstrap
  autocmd!
  autocmd VimEnter * if exists('g:plugs') && len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
        \ | PlugInstall --sync
        \ | endif
augroup END
